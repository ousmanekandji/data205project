library(tidyverse)
library(knitr)

# Create analysis variables
food <- food %>%
  mutate(
    Has_Critical = if_else(critical_count > 0, "Yes", "No"),

    Outcome_Group = case_when(
      Inspection.results %in% c("Pass") ~ "Pass",
      Inspection.results %in% c("Fail") ~ "Fail",
      TRUE ~ "Other"
    )
  )

# Keep only Pass and Fail rows
chi_data <- food %>%
  filter(Outcome_Group %in% c("Pass", "Fail"))

# -----------------------------
# Chi-Square Test
# -----------------------------

chi_table <- table(
  chi_data$Outcome_Group,
  chi_data$Has_Critical
)

kable(chi_table)

chi_result <- chisq.test(chi_table)

chi_result

# -----------------------------
# Logistic Regression
# -----------------------------

logit_model <- glm(
  is_closed ~ critical_count,
  data = food,
  family = binomial
)

summary(logit_model)

# Odds ratios
odds_ratios <- exp(coef(logit_model))

odds_ratios

# -----------------------------
# Analysis Visual
# -----------------------------

food %>%
  filter(Outcome_Group %in% c("Pass", "Fail")) %>%
  ggplot(aes(x = Outcome_Group, y = critical_count, fill = Outcome_Group)) +

  geom_boxplot(alpha = 0.7, outlier.shape = NA) +

  geom_jitter(
    width = 0.15,
    alpha = 0.25,
    size = 1.2
  ) +

  labs(
    title = "Critical violations in Pass vs Fail inspections",
    subtitle = "Failed inspections generally contain more critical violations",
    x = "Inspection outcome",
    y = "Critical violation count"
  ) +

  theme_minimal(base_size = 13)
